{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmberOS",
  "version": "../package.json",
  "identifier": "app.ember.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Ember",
    "category": "Productivity",
    "shortDescription": "Your entire life, organized in one calm, fast place.",
    "longDescription": "EmberOS — a local-first personal operating system: dashboard, calendar, tasks, notes, habits, goals, finance, mail, contacts, files and an encrypted vault, wrapped in a dark, ember-lit glass interface.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TomZ214/ember-personal-os/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFOTc4OEQ0N0UzMzQ4N0MKUldSOFNETisxSWlYenFBZzJVdWdyUTA3OWU5aUl4aXNsMGlpcjZrdTFLYW9abE41U3pNNVBmM0EK"
    }
  }
}
